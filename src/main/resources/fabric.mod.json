{
  "schemaVersion": 1,
  "id": "resourcemanager",
  "version": "${version}",
  "name": "Resource Manager",
  "description": "Allows player to see all available renaming and remodeling for items!",
  "authors": [
    "DVMN2"
  ],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/resourcemanager/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "net.dvmn2.resourcemanager.client.ResourceManagerDataGenerator"
    ],
    "client": [
      "net.dvmn2.resourcemanager.client.ResourceManagerClient"
    ],
    "main": [
      "net.dvmn2.resourcemanager.ResourceManager"
    ]
  },
  "mixins": [
    {
      "config": "resourcemanager.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
